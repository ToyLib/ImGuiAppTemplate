{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch ImGuiApp (Windows, Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/ImGuiApp.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch ImGuiApp (Windows, Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/ImGuiApp.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (Release)"
        },
        {
            "name": "Launch ImGuiApp (Linux, Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ImGuiApp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            // ログ (SDL_Log) は統合ターミナルに出力
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch ImGuiApp (Linux, Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/ImGuiApp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (Release)"
        },
        {
            "name": "Launch ImGuiApp (macOS, Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/ImGuiApp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Launch ImGuiApp (macOS, Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-release/ImGuiApp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "CMake: build (Release)"
        }
    ]
}
